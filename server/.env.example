# Copy this file to .env and fill it in. Never commit .env.

# Your octwin.ai address. Use https://staging.octwin.ai for staging.
OCTWIN_URL=https://octwin.ai

# octwin console -> Channels -> your web widget. The widget id.
WIDGET_ID=

# octwin console -> Channels -> your web widget -> Identity verification -> reveal the secret.
# It signs who the user is. It stays on this server. Never put it in the app.
IDENTITY_SECRET=

# octwin console -> In-app chat -> unread alerts -> webhook secret.
# It proves an unread alert really came from octwin.ai.
UNREAD_ALERT_SECRET=whsec_...

# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Only read when DRY_RUN=0.
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# 1 = print each push to the log instead of sending it. No Firebase needed.
# 0 = send real pushes through Firebase Cloud Messaging.
DRY_RUN=1

PORT=8080

# Only for public/simulator.html, which mounts the chat with widget.js.
# octwin console -> your workspace and project. The short names in the URL.
TENANT_SLUG=
PROJECT_SLUG=
